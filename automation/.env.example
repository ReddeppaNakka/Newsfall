# Copy to .env for local runs. NEVER commit the real values.
# In GitHub Actions these come from repository secrets instead.

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Service role key — full write access, bypasses RLS. SERVER-SIDE ONLY.
SUPABASE_SERVICE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# AI gateway. Preferred: OpenRouter (one key, any model). If OPENROUTER_API_KEY is
# unset, the legacy OpenAI-compatible LLM_* config below is used for everything.
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=
# Model routing (OpenRouter model ids). Fast = classification/extraction,
# reasoning = clustering verification/analysis/briefings, premium = major events.
LLM_FAST_MODEL=google/gemini-2.5-flash
LLM_REASONING_MODEL=anthropic/claude-sonnet-4.5
LLM_PREMIUM_MODEL=anthropic/claude-opus-4.1
# Embeddings (OpenAI-compatible /embeddings). Falls back to hashed embeddings if unavailable.
EMBEDDING_MODEL=openai/text-embedding-3-small
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=

# Legacy / fallback provider (Groq free tier, OpenAI-compatible). Still used by tools_pipeline.
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# ---------------------------------------------------------------------------
# Intelligence pipeline budgets (all optional)
# ---------------------------------------------------------------------------
INTELLIGENCE_ENABLED=1
INTEL_MAX_ARTICLES_PER_RUN=120
INTEL_MAX_LLM_CALLS_PER_RUN=400
INTEL_SOURCE_TIERS=1,2
# LOG_FORMAT=json
