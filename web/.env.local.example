# Copy to .env.local and fill in.

# PUBLIC (read-only anon/publishable key) — safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SERVER-ONLY (no NEXT_PUBLIC prefix — never sent to the browser).

# AI gateway for Ask Newsfall + semantic search + the topic brief.
# Preferred: OpenRouter. If unset, the legacy LLM_* (Groq) config below is used.
OPENROUTER_API_KEY=
LLM_FAST_MODEL=google/gemini-2.5-flash
LLM_REASONING_MODEL=anthropic/claude-sonnet-4.5
# Embeddings for semantic search (must match the automation pipeline's EMBEDDING_MODEL).
EMBEDDING_MODEL=openai/text-embedding-3-small
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=

# Legacy / fallback provider (powers the detail popup's AI brief).
LLM_API_KEY=your-groq-api-key
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# Web search grounding so the popup's facts are genuine + citable.
# Free key at https://app.tavily.com. Optional — without it the brief uses model knowledge only.
TAVILY_API_KEY=your-tavily-api-key
